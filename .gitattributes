# Normalize line endings so every checkout, including the Windows CI runner,
# matches what Prettier, rustfmt, and the formatting gates expect.
* text=auto eol=lf

# Binary assets: never convert or diff them as text.
*.png binary
*.ico binary
*.icns binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.woff binary
*.woff2 binary
*.gguf binary
